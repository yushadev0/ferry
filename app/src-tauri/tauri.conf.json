{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferry Download Center",
  "version": "0.1.0",
  "identifier": "app.yusa.ferry",
  "build": {
    "beforeDevCommand": "node scripts/sidecar.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/sidecar.mjs --release && pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ferry Download Center",
        "width": 1220,
        "height": 740,
        "minWidth": 760,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Lightweight download manager",
    "externalBin": [
      "binaries/ferry-host"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "installMode": "currentUser"
      }
    },
    "publisher": "yushadev0",
    "homepage": "https://github.com/yushadev0/ferry",
    "category": "Utility",
    "longDescription": "A lightweight, open-source download manager: segmented downloads, pause and resume, a queue with a schedule and speed limit, and a browser extension for Chrome and Edge."
  }
}
