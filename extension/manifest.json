{
  "manifest_version": 3,
  "name": "Ferry Download Center",
  "short_name": "Ferry",
  "version": "0.1.0",
  "description": "Hands your downloads to Ferry Download Center for faster, resumable downloads.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "nativeMessaging", "contextMenus", "storage", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Ferry",
    "default_popup": "popup.html",
    "default_icon": { "32": "icons/32.png", "64": "icons/64.png" }
  },
  "icons": { "32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png" }
}
